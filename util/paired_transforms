import torch
import torchvision.transforms as transforms
import torchvision.transforms.functional as F


class PairedCompose:
    is_paired = True

    def __init__(self, transforms_list):
        self.transforms = transforms_list

    def __call__(self, sar_img, opt_img):
        for transform in self.transforms:
            sar_img, opt_img = transform(sar_img, opt_img)
        return sar_img, opt_img


class PairedResize:
    def __init__(self, size, interpolation=transforms.InterpolationMode.BILINEAR, max_size=None, antialias=True):
        self.resize = transforms.Resize(
            size,
            interpolation=interpolation,
            max_size=max_size,
            antialias=antialias,
        )

    def __call__(self, sar_img, opt_img):
        return self.resize(sar_img), self.resize(opt_img)


class PairedRandomHorizontalFlip:
    def __init__(self, p=0.5):
        self.p = p

    def __call__(self, sar_img, opt_img):
        if torch.rand(1).item() < self.p:
            return F.hflip(sar_img), F.hflip(opt_img)
        return sar_img, opt_img


class PairedPILToTensor:
    def __init__(self):
        self.to_tensor = transforms.PILToTensor()

    def __call__(self, sar_img, opt_img):
        return self.to_tensor(sar_img), self.to_tensor(opt_img)
